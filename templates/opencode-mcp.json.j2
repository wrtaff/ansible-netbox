{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
{% for item in mcp_servers | dict2items %}
    "{{ item.key }}": {
      "type": "local",
      "command": {{ ([item.value.command] + item.value.args) | to_json }},
      "enabled": true{% if item.value.env | length > 0 %},
      "environment": {{ item.value.env | to_json }}{% endif %}
    }{{ "," if not loop.last else "" }}
{% endfor %}
  }
}
