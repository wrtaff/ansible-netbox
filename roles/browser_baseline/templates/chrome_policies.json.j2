{
  "HomepageLocation": "{{ browser_baseline_homepage_url }}",
  "HomepageIsNewTabPage": false,
  "RestoreOnStartup": 4,
  "RestoreOnStartupURLs": [
    "{{ browser_baseline_homepage_url }}"
  ],
  "DefaultSearchProviderEnabled": true,
  "DefaultSearchProviderName": "{{ browser_baseline_default_search_engine_name }}",
  "DefaultSearchProviderSearchURL": "{{ browser_baseline_default_search_engine_url }}",
  "DefaultSearchProviderSuggestURL": "{{ browser_baseline_default_search_engine_suggest_url }}",
  "DefaultSearchProviderIconURL": "{{ browser_baseline_default_search_engine_icon_url }}",
  "DefaultSearchProviderKeyword": "{{ browser_baseline_default_search_engine_keyword }}",
  "SiteSearchSettings": [
{% for shortcut in browser_baseline_search_shortcuts %}
    {
      "name": "{{ shortcut.name }}",
      "shortcut": "{{ shortcut.keyword }}",
      "url": "{{ shortcut.url_template }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ],
  "PasswordManagerEnabled": false,
  "AutofillAddressEnabled": false,
  "AutofillCreditCardEnabled": false,
  "ExtensionInstallForcelist": {{ chrome_extension_install_forcelist | to_json }},
  "ManagedBookmarks": {{ ([{"toplevel_name": "Managed Bookmarks"}, {"name": "Heimdall", "url": browser_baseline_homepage_url}] + (lookup('file', 'managed_bookmarklets.json') | from_json)) | to_json }},
  "3rdparty": {
    "extensions": {
      "nngceckbapebfimnlniiiahkandclblb": {
        "environment": {
          "base": "{{ vaultwarden_server_url }}"
        }
      }
    }
  }
}
