#!/bin/bash
# ==============================================================================
# Script:     scan_to_smb.sh
# Purpose:    Scan script triggered by Brother scanner button or desktop shortcut
#             Designed to push to raw SMB share (Letter, Duplex, 150dpi, True Gray)
# Secrets:    None — no credentials or secrets required
# ==============================================================================
# Revision History:
#   2026-06-15  Antigravity  Initial creation; duplex letter 150dpi scan to SMB
# ==============================================================================

# Configuration
OUTPUT_DIR="/mnt/smb/share/Documents/Scans_Folder"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
TMP_PREFIX="/tmp/scan_${TIMESTAMP}"
OUTPUT_PDF="${OUTPUT_DIR}/Scan_${TIMESTAMP}.pdf"

SCAN_SOURCE="Automatic Document Feeder(left aligned,Duplex)"
SCAN_DESC="dual-sided (duplex)"

if [ "$1" = "--simplex" ] || [ "$1" = "--single" ] || [ "$1" = "-s" ]; then
    SCAN_SOURCE="Automatic Document Feeder(left aligned)"
    SCAN_DESC="single-sided (simplex)"
fi

echo "Starting ${SCAN_DESC} Letter scan to ${OUTPUT_PDF}..."
if command -v notify-send >/dev/null 2>&1; then
    notify-send -i scanner "Brother Scanner" "Starting ${SCAN_DESC} scan to SMB..."
fi

# Ensure target directory exists (if mounted)
if [ ! -d "${OUTPUT_DIR}" ]; then
    echo "ERROR: Output directory ${OUTPUT_DIR} not found or not mounted."
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical -i dialog-error "Brother Scanner" "ERROR: ${OUTPUT_DIR} not mounted."
    fi
    exit 1
fi

# Dynamically locate Brother scanner device or use configured default
DEVICE_NAME="{{ scanner_device_name | default('') }}"
if [ -z "${DEVICE_NAME}" ]; then
    DEVICE_NAME=$(scanimage -L 2>/dev/null | grep -a -oE "brother[0-9]*:[^ '\"]+" | head -n 1)
fi

DEVICE_OPT=""
if [ -n "${DEVICE_NAME}" ]; then
    DEVICE_OPT="--device-name=${DEVICE_NAME}"
fi

# Scan using scanimage (ADF, True Gray, 150dpi, Letter Geometry)
scanimage ${DEVICE_OPT} \
          --resolution 150 \
          --mode "True Gray" \
          --source "${SCAN_SOURCE}" \
          -x 211.9 -y 279.4 \
          --batch="${TMP_PREFIX}_p%04d.tiff" \
          --format=tiff

# Convert to PDF with lossless ZIP compression to reduce size without degrading OCR
convert "${TMP_PREFIX}_p*.tiff" -compress zip "${OUTPUT_PDF}"

if [ -f "${OUTPUT_PDF}" ]; then
    echo "Successfully saved to ${OUTPUT_PDF}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i scanner "Brother Scanner" "Scan complete: $(basename "${OUTPUT_PDF}")"
    fi
else
    echo "ERROR: Scan failed, no PDF generated."
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical -i dialog-error "Brother Scanner" "Scan failed: no PDF generated."
    fi
fi

# Cleanup temp TIFFs
rm -f "${TMP_PREFIX}_p"*.tiff
