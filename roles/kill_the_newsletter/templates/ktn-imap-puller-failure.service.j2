[Unit]
Description=Alert when ktn-imap-puller.service fails
# Trac #4567: the puller reports its own soft errors, but a SIGKILL at
# TimeoutStartSec (hang) or an OOM kill leaves no chance to. This fires from
# ktn-imap-puller.service's OnFailure= and is the last-resort notifier.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ktn-imap-puller-alert
