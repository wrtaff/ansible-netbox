# ==============================================================================
# w3m keymap configuration (managed by Ansible roles/browser_baseline)
# ==============================================================================

# Vi-style navigation
keymap j DOWN
keymap k UP
keymap h LEFT
keymap l RIGHT
keymap C-f NEXT_PAGE
keymap C-b PREV_PAGE
keymap g BEGIN
keymap G END

# Bookmarks & History
keymap B BOOKMARK
keymap M-a ADD_BOOKMARK
keymap H HELP

# URL & Navigation
keymap U GOTO
keymap V VIEW
keymap B BACK

# Search
keymap / SEARCH
keymap ? SEARCH_BACK
keymap n SEARCH_NEXT
keymap N SEARCH_PREV

# General
keymap q QUIT
keymap Q EXIT
