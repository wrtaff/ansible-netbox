[Unit]
Description=Relay direct-ID Gmail labels to Kill the Newsletter
After=network-online.target kill-the-newsletter.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ ktn_user }}
Group={{ ktn_group }}
EnvironmentFile=/etc/ktn-imap-puller.env
ExecStart=/usr/local/sbin/ktn-imap-puller
# Trac #4567: a hung Gmail IMAP socket must never pin this unit in
# "activating" (that also freezes ktn-imap-puller.timer). The script keeps
# itself under KTN_PULLER_RUN_BUDGET; this is the hard backstop.
TimeoutStartSec={{ ktn_puller_timeout_start }}
# Fires only when the run is killed (timeout/OOM) -- the script handles its
# own soft errors. See ktn-imap-puller-failure.service.
OnFailure=ktn-imap-puller-failure.service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ ktn_data_directory }} {{ ktn_puller_state_directory }}
