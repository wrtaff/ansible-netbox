#!/usr/bin/env bash
export DISPLAY=${DISPLAY:-:0}
TS=$(date --iso-8601=seconds)
echo -n "$TS" | xclip -selection primary 2>/dev/null || true
echo -n "$TS" | xclip -selection clipboard 2>/dev/null || true
echo -n "$TS" | xsel --primary --input 2>/dev/null || true
echo -n "$TS" | xsel --clipboard --input 2>/dev/null || true
notify-send -u normal -t 2000 "Timestamp Copied" "$TS" 2>/dev/null || true

# Genmon XML output:
DATE_STR=$(date '+%Y-%m-%d %H:%M:%S')
HOST_TAG="{{ xfce_host_badge_name | default(inventory_hostname | upper) }}"
BADGE_COLOR="{{ xfce_host_badge_color | default('#333333') }}"

echo "<txt><span background='${BADGE_COLOR}' color='#ffffff'><b> ${HOST_TAG} </b></span> ${DATE_STR}</txt>"
echo "<tool>Host: ${HOST_TAG} (${TS}) - Click to copy ISO timestamp</tool>"
echo "<click>{{ ansible_facts['user_dir'] }}/.config/xfce4/xfce_date_click.sh</click>"
