{
  "policies": {
    "Homepage": {
      "URL": "{{ browser_baseline_homepage_url }}",
      "Locked": false,
      "StartPage": "homepage"
    },
    "DisableAppUpdate": true,
    "DisableFirefoxStudies": true,
    "DisableTelemetry": true,
    "DisablePocket": true,
    "PasswordManagerEnabled": false,
    "OfferToSaveLogins": false,
    "SearchEngines": {
      "Default": "{{ browser_baseline_default_search_engine_name }}",
      "PreventInstalls": false,
      "Add": [
{% for shortcut in browser_baseline_search_shortcuts %}
        {
          "Name": "{{ shortcut.name }}",
          "URLTemplate": "{{ shortcut.url_template }}",
          "Method": "GET",
          "IconURL": "{{ shortcut.icon_url }}",
          "Alias": "{{ shortcut.keyword }}",
          "Description": "{{ shortcut.name }} Search"
        }{% if not loop.last %},{% endif %}
{% endfor %}
      ]
    },
    "ManagedBookmarks": [
      {
        "toplevel_name": "Managed Bookmarks"
      }{% for bm in browser_baseline_common_bookmarks %},
      {
        "name": "{{ bm.name }}",
        "url": "{{ bm.url }}"
      }{% endfor %}
    ],
    "ExtensionSettings": {
{% for ext_id, ext_conf in firefox_extension_settings.items() %}
      "{{ ext_id }}": {
        "installation_mode": "{{ ext_conf.installation_mode }}",
        "install_url": "{{ ext_conf.install_url }}"
      }{% if not loop.last %},{% endif %}
{% endfor %}
    },
    "3rdparty": {
      "Extensions": {
        "{446900e4-71c2-419f-a6a7-df9c091e268b}": {
          "environment": {
            "base": "{{ vaultwarden_server_url }}"
          }
        }
      }
    }
  }
}
