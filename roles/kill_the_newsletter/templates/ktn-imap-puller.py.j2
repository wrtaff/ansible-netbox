#!/usr/bin/env python3
"""Relay Gmail messages bearing direct-ID KTN labels to the local SMTP ingress.

Design notes (see Trac #4567):
* Gmail IMAP throttles every command by several seconds once an account has
  been hammered, so this puller issues the *minimum* number of commands:
  one SELECT of All Mail and one X-GM-RAW search across every ktn/ label,
  instead of SELECT+SEARCH per label (that was ~95 commands/run and wedged
  the service for days).
* Every network client has an explicit timeout; a stalled IMAP socket can
  no longer hang the run forever.
* The run has an overall wall-clock budget. When it expires the puller
  saves progress and exits 0 so systemd's timer keeps scheduling.
* Messages larger than the KTN loopback SMTP DATA limit are skipped with a
  warning rather than raising SMTPDataError 552 every run.
* Every run emits a Graylog heartbeat line (so "no alerts" is distinguishable
  from "no monitor" -- Trac #4494 lesson), and a hard abort also sends mail.
  A missing-heartbeat Graylog event definition is the backstop for the
  service being dead entirely.
"""

import email
import email.policy
import imaplib
import json
import logging
import os
import re
import smtplib
import socket
import subprocess
import sys
import time

LABEL_PATTERN = re.compile(r'(?:^|")(?P<label>ktn/[a-z0-9]+)(?:"|$)')
GM_LABEL_TOKEN = re.compile(r'ktn/[a-z0-9]+')
LOG = logging.getLogger("ktn-imap-puller")


def env_int(name, default):
    try:
        return int(os.environ.get(name, "").strip() or default)
    except ValueError:
        return default


IMAP_TIMEOUT = env_int("KTN_IMAP_TIMEOUT", 60)
SMTP_TIMEOUT = env_int("KTN_SMTP_TIMEOUT", 30)
RUN_BUDGET_SECONDS = env_int("KTN_PULLER_RUN_BUDGET", 1200)
MAX_MESSAGE_BYTES = env_int("KTN_MAX_MESSAGE_BYTES", 524288)
GRAYLOG_HOST = os.environ.get("KTN_GRAYLOG_HOST", "").strip()
GRAYLOG_PORT = os.environ.get("KTN_GRAYLOG_PORT", "1514").strip() or "1514"
ALERT_EMAIL = os.environ.get("KTN_ALERT_EMAIL", "").strip()
NODE = socket.gethostname()


def graylog(level, message):
    """Emit one syslog line to Graylog. Best-effort; never raises."""
    if not GRAYLOG_HOST:
        return
    try:
        subprocess.run(
            ["logger", "-d", "-n", GRAYLOG_HOST, "-P", GRAYLOG_PORT,
             f"{level}: ktn-imap-puller on {NODE}: {message}"],
            timeout=10, check=False,
        )
    except Exception as exc:  # noqa: BLE001 - alerting must not break the run
        LOG.warning("Graylog notify failed: %s", exc)


def alert_email(subject, body):
    """Send an alert mail. Best-effort; never raises. Reserved for hard failures
    so a flaky IMAP session cannot mailbomb (Trac #4494 lesson)."""
    if not ALERT_EMAIL:
        return
    try:
        subprocess.run(
            ["mail", "-s", subject] + ALERT_EMAIL.split(","),
            input=body.encode("utf-8"), timeout=30, check=False,
        )
    except Exception as exc:  # noqa: BLE001
        LOG.warning("Alert mail failed: %s", exc)


def load_delivery_state(state_path):
    try:
        with open(state_path, encoding="utf-8") as state_file:
            data = json.load(state_file)
            if isinstance(data, list):
                return set(data)
    except FileNotFoundError:
        LOG.debug("Delivery state file not found at %s; starting clean", state_path)
    except json.JSONDecodeError as exc:
        LOG.warning("Malformed delivery state file at %s (%s); starting clean", state_path, exc)
    return set()


def save_delivery_state(state_path, delivered_keys):
    parent_dir = os.path.dirname(state_path)
    if parent_dir:
        os.makedirs(parent_dir, exist_ok=True)
    tmp_path = f"{state_path}.tmp"
    with open(tmp_path, "w", encoding="utf-8") as state_file:
        json.dump(sorted(delivered_keys), state_file, indent=2)
    os.replace(tmp_path, state_path)


def get_direct_id_labels(client):
    status, mailboxes = client.list()
    if status != "OK":
        raise RuntimeError("Unable to list Gmail labels")
    labels = []
    for mailbox in mailboxes or []:
        match = LABEL_PATTERN.search(mailbox.decode("utf-8", errors="replace"))
        if match:
            labels.append(match.group("label"))
    return labels


def parse_fetch_map(fetch_data):
    """Map UID -> {"labels": set(), "size": int} from a FETCH response."""
    result = {}
    for item in fetch_data or []:
        blob = item[0] if isinstance(item, tuple) else item
        if not isinstance(blob, (bytes, bytearray)):
            continue
        text = blob.decode("utf-8", errors="replace")
        uid_match = re.search(r"UID (\d+)", text)
        if not uid_match:
            continue
        uid = uid_match.group(1)
        size_match = re.search(r"RFC822\.SIZE (\d+)", text)
        labels_match = re.search(r"X-GM-LABELS \(([^)]*)\)", text)
        result[uid] = {
            "labels": set(GM_LABEL_TOKEN.findall(labels_match.group(1))) if labels_match else set(),
            "size": int(size_match.group(1)) if size_match else None,
        }
    return result


def deliver_message(raw_bytes, recipient):
    with smtplib.SMTP(
        os.environ["KTN_SMTP_HOST"],
        int(os.environ["KTN_SMTP_PORT"]),
        timeout=SMTP_TIMEOUT,
    ) as smtp:
        smtp.sendmail(os.environ["KTN_IMAP_USER"], [recipient], raw_bytes)


def subject_of(raw_bytes):
    try:
        msg = email.message_from_bytes(raw_bytes, policy=email.policy.default)
        return (msg.get("subject") or "").strip() or "(no subject)"
    except Exception:  # noqa: BLE001 - best-effort logging only
        return "(unparseable subject)"


def run(client, labels, delivered_keys, state_path, deadline):
    status, _ = client.select('"[Gmail]/All Mail"', readonly=False)
    if status != "OK":
        raise RuntimeError("Unable to select [Gmail]/All Mail")

    query = " OR ".join(f"label:{label}" for label in labels)
    status, search_data = client.uid("search", None, "X-GM-RAW", f'"{query}"')
    if status != "OK":
        raise RuntimeError("X-GM-RAW label search failed")
    uids = search_data[0].split() if search_data and search_data[0] else []
    # Newest first: KTN keeps only the most recent entries per feed, and a
    # large stale backlog would otherwise starve fresh mail of the run budget.
    uids.sort(key=lambda u: int(u), reverse=True)
    if not uids:
        LOG.info("No labelled messages pending")
        return 0, 0, [], 0

    status, meta = client.uid("fetch", b",".join(uids), "(X-GM-LABELS RFC822.SIZE)")
    if status != "OK":
        raise RuntimeError("Unable to fetch label/size metadata")
    uid_meta = parse_fetch_map(meta)

    delivered = 0
    skipped = 0
    errors = []
    hostname = os.environ["KTN_HOSTNAME"]

    budget_hit = False
    for raw_uid in uids:
        if time.monotonic() > deadline:
            budget_hit = True
            LOG.warning("Run budget exhausted; %d message(s) left for next run", len(uids) - delivered - skipped)
            break

        uid = raw_uid.decode()
        info = uid_meta.get(uid, {"labels": set(), "size": None})
        feed_labels = sorted(info["labels"])
        if not feed_labels:
            continue

        key = f"gmuid:{uid}"
        if key in delivered_keys:
            continue

        try:
            if info["size"] is not None and info["size"] > MAX_MESSAGE_BYTES:
                status, hdr = client.uid("fetch", raw_uid, "(BODY.PEEK[HEADER.FIELDS (SUBJECT)])")
                subj = ""
                if status == "OK":
                    for part in hdr:
                        if isinstance(part, tuple):
                            subj = subject_of(part[1])
                LOG.warning(
                    "Skipping oversized message (%d B > %d) for %s: %s",
                    info["size"], MAX_MESSAGE_BYTES, ",".join(feed_labels), subj,
                )
                delivered_keys.add(key)
                save_delivery_state(state_path, delivered_keys)
                skipped += 1
                continue

            status, message_data = client.uid("fetch", raw_uid, "(RFC822)")
            if status != "OK" or not message_data or not isinstance(message_data[0], tuple):
                raise RuntimeError(f"Unable to fetch RFC822 for UID {uid}")
            raw_bytes = message_data[0][1]

            for label in feed_labels:
                feed_id = label.removeprefix("ktn/")
                deliver_message(raw_bytes, f"{feed_id}@{hostname}")

            delivered_keys.add(key)
            save_delivery_state(state_path, delivered_keys)

            status, _ = client.uid("store", raw_uid, "-X-GM-LABELS", "(%s)" % " ".join(f'"{l}"' for l in feed_labels))
            if status != "OK":
                raise RuntimeError(f"Delivered UID {uid} but could not remove {feed_labels}")

            LOG.info("Relayed UID %s to %s", uid, ",".join(feed_labels))
            delivered += 1
        except Exception as exc:  # noqa: BLE001 - isolate per-message failures
            LOG.error("Failed processing UID %s (%s): %s", uid, ",".join(feed_labels), exc)
            errors.append((uid, exc))

    pending = sum(
        1 for u in uids
        if uid_meta.get(u.decode(), {}).get("labels")
        and f"gmuid:{u.decode()}" not in delivered_keys
    )
    if budget_hit:
        LOG.info("Stopped on budget with %d message(s) still pending", pending)
    return delivered, skipped, errors, pending


def main():
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    )
    socket.setdefaulttimeout(IMAP_TIMEOUT)
    state_path = os.environ.get("KTN_DELIVERY_STATE", "/var/lib/ktn-imap-puller/delivered-messages.json")
    delivered_keys = load_delivery_state(state_path)
    deadline = time.monotonic() + RUN_BUDGET_SECONDS

    started = time.monotonic()
    labels = []
    delivered = skipped = pending = 0
    errors = []
    try:
        with imaplib.IMAP4_SSL(
            os.environ["KTN_IMAP_HOST"],
            int(os.environ["KTN_IMAP_PORT"]),
            timeout=IMAP_TIMEOUT,
        ) as client:
            client.login(os.environ["KTN_IMAP_USER"], os.environ["KTN_IMAP_PASSWORD"])
            labels = get_direct_id_labels(client)
            if not labels:
                LOG.info("No ktn/ labels defined; nothing to do")
                graylog("INFO", "heartbeat: no ktn/ labels defined")
                return
            delivered, skipped, errors, pending = run(client, labels, delivered_keys, state_path, deadline)
            try:
                client.logout()
            except Exception as exc:  # noqa: BLE001
                LOG.warning("IMAP logout failed: %s", exc)
    except (imaplib.IMAP4.error, OSError) as exc:
        elapsed = time.monotonic() - started
        LOG.error("KTN IMAP puller run aborted after %.0fs: %s", elapsed, exc)
        graylog("CRITICAL", f"run ABORTED after {elapsed:.0f}s: {exc}")
        alert_email(
            f"CRITICAL: KTN IMAP puller aborted on {NODE}",
            f"The Kill the Newsletter IMAP puller aborted after {elapsed:.0f}s.\n\n"
            f"Error: {exc}\n\n"
            f"Newsletters are not being relayed to their feeds until this clears.\n"
            f"Check: journalctl -u ktn-imap-puller.service on {NODE}\n"
            f"Trac: http://trac.gafla.us.com/ticket/4567\n",
        )
        sys.exit(1)

    elapsed = time.monotonic() - started
    summary = (
        f"{delivered} delivered, {skipped} skipped, {len(errors)} error(s), "
        f"{pending} pending, {len(labels)} label(s) in {elapsed:.0f}s"
    )
    LOG.info("KTN IMAP puller run finished: %s", summary)
    level = "ERROR" if errors else "INFO"
    graylog(level, f"heartbeat: {summary}")

    # Per-message errors don't wedge the timer or exit non-zero, but a run that
    # delivered nothing while errors piled up is worth a mail (rare; the
    # per-message except clause only trips on real IMAP/SMTP faults).
    if errors and delivered == 0:
        detail = "\n".join(f"  UID {uid}: {exc}" for uid, exc in errors[:20])
        alert_email(
            f"ERROR: KTN IMAP puller delivered 0 with {len(errors)} error(s) on {NODE}",
            f"{summary}\n\nFirst errors:\n{detail}\n\n"
            f"Trac: http://trac.gafla.us.com/ticket/4567\n",
        )


if __name__ == "__main__":
    main()
