#!/usr/bin/env python3
"""Relay Gmail messages bearing direct-ID KTN labels to the local SMTP ingress."""

import imaplib
import json
import logging
import os
import re
import smtplib
import ssl
import sys


LABEL_PATTERN = re.compile(r'(?:^|")(?P<label>ktn/[a-z0-9]+)(?:"|$)')
LOG = logging.getLogger("ktn-imap-puller")


def load_delivery_state(state_path):
    try:
        with open(state_path, encoding="utf-8") as state_file:
            data = json.load(state_file)
            if isinstance(data, list):
                return set(data)
    except FileNotFoundError:
        LOG.debug("Delivery state file not found at %s; starting clean", state_path)
    except json.JSONDecodeError as exc:
        LOG.warning("Malformed delivery state file at %s (%s); starting clean", state_path, exc)
    return set()


def save_delivery_state(state_path, delivered_keys):
    parent_dir = os.path.dirname(state_path)
    if parent_dir:
        os.makedirs(parent_dir, exist_ok=True)
    tmp_path = f"{state_path}.tmp"
    with open(tmp_path, "w", encoding="utf-8") as state_file:
        json.dump(sorted(delivered_keys), state_file, indent=2)
    os.replace(tmp_path, state_path)


def get_direct_id_labels(client):
    status, mailboxes = client.list()
    if status != "OK":
        raise RuntimeError("Unable to list Gmail labels")

    labels = []
    for mailbox in mailboxes or []:
        match = LABEL_PATTERN.search(mailbox.decode("utf-8", errors="replace"))
        if match:
            labels.append(match.group("label"))
    return labels


def relay_label(client, label, delivered_keys, state_path):
    status, _ = client.select(f'"{label}"', readonly=False)
    if status != "OK":
        raise RuntimeError(f"Unable to select {label}")

    status, data = client.uid("search", None, "ALL")
    if status != "OK":
        raise RuntimeError(f"Unable to search {label}")

    feed_id = label.removeprefix("ktn/")
    recipient = f"{feed_id}@{os.environ['KTN_HOSTNAME']}"
    delivered = 0
    message_uids = data[0].split() if data and data[0] else []

    for message_uid in message_uids:
        uid = message_uid.decode()
        key = f"{label}:{uid}"
        if key in delivered_keys:
            continue
        status, message_data = client.uid("fetch", message_uid, "(RFC822)")
        if status != "OK" or not message_data or not isinstance(message_data[0], tuple):
            raise RuntimeError(f"Unable to fetch message UID {uid} from {label}")

        # KTN accepts plaintext SMTP only on its loopback-only ingress port.
        with smtplib.SMTP(
            os.environ["KTN_SMTP_HOST"],
            int(os.environ["KTN_SMTP_PORT"]),
            timeout=30,
        ) as smtp:
            smtp.sendmail(os.environ["KTN_IMAP_USER"], [recipient], message_data[0][1])

        delivered_keys.add(key)
        save_delivery_state(state_path, delivered_keys)
        status, _ = client.uid("store", message_uid, "-X-GM-LABELS", f'("{label}")')
        if status != "OK":
            raise RuntimeError(f"Delivered message UID {uid} but could not remove {label}")
        status, labels = client.uid("fetch", message_uid, "(X-GM-LABELS)")
        if status != "OK" or label.encode() in b"".join(labels):
            raise RuntimeError(f"Delivered message UID {uid} but {label} remains applied")
        delivered += 1
    return delivered


def main():
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    )
    state_path = os.environ.get("KTN_DELIVERY_STATE", "/var/lib/ktn-imap-puller/delivered-messages.json")
    delivered_keys = load_delivery_state(state_path)

    with imaplib.IMAP4_SSL(
        os.environ["KTN_IMAP_HOST"],
        int(os.environ["KTN_IMAP_PORT"]),
        ssl_context=ssl.create_default_context(),
    ) as client:
        client.login(os.environ["KTN_IMAP_USER"], os.environ["KTN_IMAP_PASSWORD"])
        labels = get_direct_id_labels(client)
        total_delivered = 0
        errors = []
        for label in labels:
            try:
                delivered = relay_label(client, label, delivered_keys, state_path)
                total_delivered += delivered
                if delivered > 0:
                    LOG.info("Relayed %d message(s) for %s", delivered, label)
            except Exception as exc:
                LOG.error("Failed processing label %s: %s", label, exc)
                errors.append((label, exc))
        client.logout()

    LOG.info("KTN IMAP puller run finished: %d message(s) delivered across %d label(s)", total_delivered, len(labels))
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
