#!/usr/bin/env python3
"""Root-owned local broker. It exposes no secret or session value."""
import json
import os
import grp
import socket
import subprocess
import time

RUNTIME = "/run/vaultwarden-broker"
SOCKET = f"{RUNTIME}/ops.sock"
ADMIN_SOCKET = f"{RUNTIME}/admin.sock"
MAPPINGS = "/etc/vaultwarden-broker/mappings.json"
STATE = {"session": None, "unlocked_until": 0}

def response(conn, payload):
    conn.sendall((json.dumps(payload, separators=(",", ":")) + "\n").encode())

def run_bw(arguments):
    env = os.environ.copy()
    env["BW_SESSION"] = STATE["session"]
    return subprocess.run(["runuser", "-u", "{{ vaultwarden_broker_user }}", "--preserve-environment", "--", "bw", *arguments], env=env, capture_output=True, text=True, check=False)

def mapping_for(request):
    with open(MAPPINGS, encoding="utf-8") as handle:
        mappings = {item["id"]: item for item in json.load(handle)["vaultwarden_broker_mappings"]}
    return mappings.get(request.get("mapping"))

def session_is_active():
    if time.time() >= STATE["unlocked_until"]:
        STATE["session"] = None
        STATE["unlocked_until"] = 0
        return False
    return STATE["session"] is not None

def handle_ops(request):
    operation = request.get("operation")
    if operation == "status":
        return {"ok": True, "unlocked": session_is_active()}
    if operation not in {"metadata", "mirror"} or not session_is_active():
        return {"ok": False, "error": "operation unavailable"}
    mapping = mapping_for(request)
    if not mapping:
        return {"ok": False, "error": "unknown mapping"}
    if operation == "mirror":
        env = os.environ | {"BW_SESSION": STATE["session"], "ANSIBLE_CONFIG": "/home/will/ansible-netbox/ansible.cfg"}
        result = subprocess.run(["/usr/bin/ansible-playbook", "/etc/vaultwarden-broker/mirror.yml", "--vault-password-file", "/home/will/.vault_pass", "-e", f"mapping_id={mapping['id']}"], env=env, capture_output=True, text=True, check=False)
        return {"ok": result.returncode == 0, "error": "mirror failed" if result.returncode else None}
    result = run_bw(["get", "item", mapping["item_id"]])
    if result.returncode:
        return {"ok": False, "error": "metadata lookup failed"}
    item = json.loads(result.stdout)
    return {"ok": True, "id": item.get("id"), "name": item.get("name"), "revision_date": item.get("revisionDate")}

def serve(server, handler):
    while True:
        conn, _ = server.accept()
        with conn:
            conn.settimeout(5)
            raw = conn.recv(4096)
            try:
                request = json.loads(raw.decode())
                response(conn, handler(request))
            except (UnicodeDecodeError, json.JSONDecodeError, TimeoutError):
                response(conn, {"ok": False, "error": "invalid request"})

def main():
    os.makedirs(RUNTIME, mode=0o750, exist_ok=True)
    os.chown(RUNTIME, 0, grp.getgrnam("{{ vaultwarden_broker_socket_group }}").gr_gid)
    os.chmod(RUNTIME, 0o750)
    try:
        os.unlink(SOCKET)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCKET)
    os.chown(SOCKET, 0, grp.getgrnam("{{ vaultwarden_broker_socket_group }}").gr_gid)
    os.chmod(SOCKET, 0o660)
    server.listen(8)
    # The admin listener is root-only, so only the interactive helper can set a session.
    admin = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    admin.bind(ADMIN_SOCKET)
    os.chmod(ADMIN_SOCKET, 0o600)
    admin.listen(1)
    import threading
    threading.Thread(target=serve, args=(server, handle_ops), daemon=True).start()
    def handle_admin(request):
        if request.get("operation") != "set_session" or not isinstance(request.get("session"), str):
            return {"ok": False, "error": "operation unavailable"}
        STATE["session"] = request["session"]
        STATE["unlocked_until"] = time.time() + {{ vaultwarden_broker_session_ttl_seconds }}
        return {"ok": True}
    serve(admin, handle_admin)

if __name__ == "__main__":
    main()
