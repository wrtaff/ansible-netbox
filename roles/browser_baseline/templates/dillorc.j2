# ==============================================================================
# Dillo configuration (managed by Ansible roles/browser_baseline)
# ==============================================================================

# Search shortcuts
{% for s in browser_baseline_search_shortcuts %}
{% if s.dillo_url is defined and s.dillo_url %}
search_url="{{ s.keyword }} {{ s.name }} {{ s.dillo_url }}"
{% endif %}
{% endfor %}

# Font scaling baseline
font_factor={{ browser_baseline_dillo_font_factor | default(1.25) }}
